# Copy to .env and fill in. Never commit .env.
#
# Generate strong values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Your OathNet API key. Server-side only; it is never sent to the browser.
OATHNET_API_KEY=oath_8LufoO-HFh9Ay96T1Wbd3AT2con35TBc-5bKOB-DPwI

# Shared password for the console. Must be at least 12 characters.
SITE_PASSWORD=rayvo2549

# Signs the session cookie. Must be at least 32 characters. Rotating it signs
# every operator out.
SECRET_KEY=BcnHecVE6oP46oFY5mxRWcKPcj8RVcBS

# Set to 1 to let authenticated operators view plaintext passwords, cookies,
# and tokens. Off by default. Leave off unless you need to read the data.
ALLOW_REVEAL=0

# Session lifetime in seconds. Default 28800 (8 hours).
# SESSION_MAX_AGE=28800

# Override only if you are self-hosting against a different host.
# OATHNET_BASE_URL=https://oathnet.org/api
